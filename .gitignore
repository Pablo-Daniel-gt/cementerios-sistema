# Entornos virtuales
venv/
env/
ENV/
# Archivos de configuración sensible y variables de entorno
.env
*.env
# Archivos compilados de Python
__pycache__/
*.py[cod]
*$py.class
# Base de datos SQLite local (por si se genera accidentalmente)
*.sqlite3
*.sqlite3-journal
# Archivos de medios subidos por usuarios (PDFs de RENAP/DPI)
media/
# Archivos estáticos recopilados por collectstatic
staticfiles/
# Carpetas de editores e IDEs
.vscode/
.idea/
*.swp
# Archivos de sistema operativo
Thumbs.db
Desktop.ini
.DS_Store

# Archivos del frontend 
client/node_modules/
client/dist/

# Archivos extra: instrucciones .md y .txt
skills/
instructions/

# Prototipos UI y Mockups temporales (no subir a git)
prototipos_ui/
mockups/